<%= form_with(model: order, id: "order-form") do |form| %>
  <% if order.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h4><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h4>
      <ul>
        <% order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <h4>Customer Information</h4>
  <div class="mb-3">
    <%= form.label :customer_name, class: "form-label" %>
    <%= form.text_field :customer_name, class: "form-control", placeholder: "John Doe" %>
  </div>

  <div class="mb-3">
    <%= form.label :customer_email, class: "form-label" %>
    <%= form.email_field :customer_email, class: "form-control", placeholder: "john@example.com" %>
  </div>

  <div class="mb-3">
    <%= form.label :customer_address, class: "form-label" %>
    <%= form.text_area :customer_address, class: "form-control", rows: 3, placeholder: "123 Main St, City, State, ZIP" %>
  </div>

  <div class="mb-3">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, [['Pending', 'pending'], ['Processing', 'processing'], ['Completed', 'completed'], ['Cancelled', 'cancelled']], {}, class: "form-select" %>
  </div>

  <hr class="my-4">

  <h4>Order Items</h4>
  <div id="order-items">
    <%= form.fields_for :order_items do |item_form| %>
      <%= render "order_item_fields", form: item_form, products: @products %>
    <% end %>
  </div>

  <div class="mb-3">
    <button type="button" id="add-item" class="btn btn-secondary"
            data-products="<%= @products.map { |p| { id: p.id, name: p.name, price: p.price } }.to_json %>">
      Add Product
    </button>
  </div>

  <hr class="my-4">

  <div class="mb-3">
    <h5>Total: <span id="order-total">$0.00</span></h5>
  </div>

  <div class="mb-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", orders_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<script>
  // Function to initialize the order form
  function initializeOrderForm() {
    const orderForm = document.getElementById('order-form');
    const orderItemsContainer = document.getElementById('order-items');
    const addItemButton = document.getElementById('add-item');

    // Exit if form doesn't exist or is already initialized
    if (!orderForm || orderForm.dataset.initialized === 'true') {
      return;
    }

    // Mark as initialized to prevent double initialization
    orderForm.dataset.initialized = 'true';

    let itemIndex = new Date().getTime();

    // Get products data from the button's data attribute
    const productsData = JSON.parse(addItemButton.dataset.products || '[]');

    console.log('Order form initialized with', productsData.length, 'products');

    function calculateTotal() {
      let total = 0;
      document.querySelectorAll('.order-item-row').forEach(function(row) {
        if (row.style.display !== 'none') {
          const quantityInput = row.querySelector('.quantity-input');
          const unitPriceInput = row.querySelector('.unit-price-input');

          if (quantityInput && unitPriceInput) {
            const quantity = parseFloat(quantityInput.value) || 0;
            const unitPrice = parseFloat(unitPriceInput.value) || 0;
            total += quantity * unitPrice;
          }
        }
      });
      document.getElementById('order-total').textContent = '$' + total.toFixed(2);
    }

    function updateUnitPrice(select) {
      const selectedOption = select.options[select.selectedIndex];
      const price = selectedOption.dataset.price;
      const row = select.closest('.order-item-row');
      const unitPriceInput = row.querySelector('.unit-price-input');
      if (unitPriceInput && price) {
        unitPriceInput.value = parseFloat(price).toFixed(2);
        calculateTotal();
      }
    }

    // Event delegation for dynamically added elements
    orderForm.addEventListener('change', function(e) {
      if (e.target.classList.contains('product-select')) {
        updateUnitPrice(e.target);
      } else if (e.target.classList.contains('quantity-input') || e.target.classList.contains('unit-price-input')) {
        calculateTotal();
      }
    });

    orderForm.addEventListener('click', function(e) {
      if (e.target.classList.contains('remove-item')) {
        e.preventDefault();
        const row = e.target.closest('.order-item-row');
        const destroyInput = row.querySelector('input[name*="_destroy"]');
        if (destroyInput) {
          destroyInput.value = '1';
        }
        row.style.display = 'none';
        calculateTotal();
      }
    });

    addItemButton.addEventListener('click', function() {
      console.log('Add Product clicked');

      // Build product options HTML
      let productOptionsHtml = '<option value="">Select a product</option>';
      productsData.forEach(function(product) {
        productOptionsHtml += `<option value="${product.id}" data-price="${product.price}">${product.name} - $${parseFloat(product.price).toFixed(2)}</option>`;
      });

      const newItem = `
        <div class="order-item-row mb-3 p-3 border rounded">
          <div class="row">
            <div class="col-md-5">
              <label class="form-label">Product</label>
              <select name="order[order_items_attributes][${itemIndex}][product_id]" class="form-select product-select">
                ${productOptionsHtml}
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">Quantity</label>
              <input type="number" name="order[order_items_attributes][${itemIndex}][quantity]" class="form-control quantity-input" value="1" min="1">
            </div>
            <div class="col-md-3">
              <label class="form-label">Unit Price</label>
              <input type="number" name="order[order_items_attributes][${itemIndex}][unit_price]" class="form-control unit-price-input" step="0.01" readonly>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="button" class="btn btn-danger remove-item">Remove</button>
            </div>
          </div>
        </div>
      `;
      orderItemsContainer.insertAdjacentHTML('beforeend', newItem);
      itemIndex++;
      console.log('Product row added');
    });

    // Calculate total on page load
    calculateTotal();
  }

  // Initialize on both DOMContentLoaded and turbo:load
  document.addEventListener('DOMContentLoaded', initializeOrderForm);
  document.addEventListener('turbo:load', initializeOrderForm);

  // Clean up on page unload to prevent memory leaks
  document.addEventListener('turbo:before-cache', function() {
    const orderForm = document.getElementById('order-form');
    if (orderForm) {
      orderForm.dataset.initialized = 'false';
    }
  });
</script>
