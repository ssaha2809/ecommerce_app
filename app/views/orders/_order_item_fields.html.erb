<div class="order-item-row mb-3 p-3 border rounded">
  <%= form.hidden_field :_destroy %>
  <div class="row">
    <div class="col-md-5">
      <%= form.label :product_id, "Product", class: "form-label" %>
      <%= form.select :product_id,
          options_for_select(products.map { |p| ["#{p.name} - $#{number_with_precision(p.price, precision: 2)}", p.id, { 'data-price' => p.price }] }, form.object.product_id),
          { include_blank: "Select a product" },
          class: "form-select product-select" %>
    </div>
    <div class="col-md-2">
      <%= form.label :quantity, class: "form-label" %>
      <%= form.number_field :quantity, class: "form-control quantity-input", value: form.object.quantity || 1, min: 1 %>
    </div>
    <div class="col-md-3">
      <%= form.label :unit_price, class: "form-label" %>
      <%= form.number_field :unit_price, class: "form-control unit-price-input", step: 0.01 %>
    </div>
    <div class="col-md-2 d-flex align-items-end">
      <button type="button" class="btn btn-danger remove-item">Remove</button>
    </div>
  </div>
</div>
