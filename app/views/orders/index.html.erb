<% content_for :title, "Orders" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Orders</h1>
  <%= link_to "New Order", new_order_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Order ID</th>
        <th>Customer Name</th>
        <th>Customer Email</th>
        <th>Total Amount</th>
        <th>Status</th>
        <th>Created At</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td>#<%= order.id %></td>
          <td><%= order.customer_name %></td>
          <td><%= order.customer_email %></td>
          <td>$<%= number_with_precision(order.total_amount, precision: 2) %></td>
          <td>
            <span class="badge bg-<%= order.status == 'completed' ? 'success' : order.status == 'processing' ? 'warning' : order.status == 'cancelled' ? 'danger' : 'secondary' %>">
              <%= order.status.titleize %>
            </span>
          </td>
          <td><%= order.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td>
            <%= link_to "Show", order, class: "btn btn-sm btn-info" %>
            <%= link_to "Edit", edit_order_path(order), class: "btn btn-sm btn-warning" %>
            <%= button_to "Delete", order, method: :delete, class: "btn btn-sm btn-danger",
                form: { data: { turbo_confirm: "Are you sure?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
