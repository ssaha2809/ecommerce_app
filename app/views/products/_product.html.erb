<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

  <div>
    <strong>Price:</strong>
    $<%= number_with_precision(product.price_cents / 100.0, precision: 2) %>
  </div>

  <div>
    <strong>Stock quantity:</strong>
    <%= product.stock_quantity %>
  </div>

</div>
