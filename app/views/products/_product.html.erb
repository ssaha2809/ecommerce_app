<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= number_to_currency(product.price, unit: "€", format: "%n %u") %>
  </div>

  <div>
    <strong>Stock quantity:</strong>
    <%= product.stock_quantity %>
  </div>

</div>
