<% content_for :title, "Products" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Products</h1>
  <%= link_to "New Product", new_product_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Stock Quantity</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= product.name %></td>
          <td><%= truncate(product.description, length: 50) %></td>
          <td>$<%= number_with_precision(product.price, precision: 2) %></td>
          <td><%= product.stock_quantity %></td>
          <td>
            <%= link_to "Show", product, class: "btn btn-sm btn-info" %>
            <%= link_to "Edit", edit_product_path(product), class: "btn btn-sm btn-warning" %>
            <%= button_to "Delete", product, method: :delete, class: "btn btn-sm btn-danger",
                form: { data: { turbo_confirm: "Are you sure?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
