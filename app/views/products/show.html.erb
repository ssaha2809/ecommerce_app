<% content_for :title, @product.name %>

<div class="card">
  <div class="card-header">
    <h1><%= @product.name %></h1>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h5>Description</h5>
        <p><%= @product.description %></p>
      </div>
      <div class="col-md-3">
        <h5>Price</h5>
        <p class="text-success h4">$<%= number_with_precision(@product.price_cents / 100.0, precision: 2) %></p>
      </div>
      <div class="col-md-3">
        <h5>Stock Quantity</h5>
        <p><%= @product.stock_quantity %></p>
      </div>
    </div>
  </div>
  <div class="card-footer">
    <%= link_to "Edit", edit_product_path(@product), class: "btn btn-warning" %>
    <%= link_to "Back to Products", products_path, class: "btn btn-secondary" %>
    <%= button_to "Delete", @product, method: :delete, class: "btn btn-danger",
        form: { data: { turbo_confirm: "Are you sure?" } } %>
  </div>
</div>
